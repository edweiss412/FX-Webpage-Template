# MCP playwright tool transient artifacts (console logs, page YAML snapshots).
.playwright-mcp/

# Attention-gallery screenshot sweep output (local review artifact, regenerated
# by `pnpm screenshot:gallery`; never committed). Top-level only — does NOT
# shadow the committed public/help/screenshots/.
/screenshots/

# Hook audit log for codex-companion adversarial-review prompts (~/.claude/hooks/check-codex-adversarial-review-fresh-eyes.sh)
.codex-adversarial-review-audit.log

# pnpm content-addressable store (created when Docker pinned-image runs pnpm install with $PWD mounted at /work)
.pnpm-store/

# Playwright test-results scratch dir (created by screenshot capture + walker runs)
tmp/

# M12 rate-limit fixture snapshot files (created by `pnpm validation:report-fixtures
# --outcome rate-limit-admin|rate-limit-crew` per the F34/F36 snapshot+restore contracts;
# `validation_state` cannot be used as backend due to `CHECK (key = 'validation_seed')`
# singleton constraint — file-backed is the sole supported strategy per R41 F37)
.validation-state/

# M12 Phase 1 walk launchpad (local-only; embeds live validation share-tokens — must never be committed)
.validation-local/

.build-locks/

# Codex companion per-run state (broker sockets, session/thread IDs, prompts) — never source
.codex-companion*/

# Subagent-driven-development working files (briefs/reports/diffs). Canonical
# location is the git-dir (`git rev-parse --git-path sdd`); a working-tree `sdd/`
# is a stray relative-path write and must never be committed.
sdd/

# Brainstorming visual-companion mockups
.superpowers/

.impeccable/

# Codex adversarial-review scratch briefs/results (never source)
.codex-reviews/

# Cross-model review artifacts (transcripts, briefs, verdicts) - never committed
.review/

tests/.spec-lint-fixtures*/

# Scoped-shard scratch for the source-mutation harness. `guardSurfaces.shard0..3`
# are the REAL, committed shards that `_metaSourceShardIntegrity` pins byte-for-byte;
# anything above that range is a throwaway that scopes a run to one surface and must
# never be committed. It reached main-bound commits once already, via `git add -A`
# over a tree that deliberately holds untracked scratch — the one command that stages
# everything is exactly the one that captures a file whose whole contract is to stay
# untracked. Four required checks went red on a fresh checkout while every local run
# looked normal, because the file is on disk whether or not it is TRACKED.
#
# A control in the tree rather than in anyone's intentions: "I will remember to stage
# by path" is the shape of discipline that fails at hour six of an arc.
tests/mutation/guardSurfaces.shard[4-9].test.ts

# Scratch probe scripts for spec/plan calibration (the `.probe/` convention used by
# this arc's authoring session; `docs/superpowers/plans/ci/2026-08-19-planlint-declared-limit-pin-collision-HANDOFF.md`
# names `.probe/refresh-filing.py` as a scratch, untracked helper). They are design
# inputs re-run at implementation time, never shipped source. Ignored rather than
# merely avoided: a `git add -A` sweeps an unignored scratch dir into a commit, and
# an author remembering to use explicit pathspecs is the kind of control that fails
# at hour six.
.probe/

# spec-time probe fixtures, written and removed by p1-e2e.ts (never committed)
tests/_probe_nondet/

# per-run mutation outcome records (design 5.2)
.mutation-records/
